{
  "name": "madoka-dsh-opencode-go-session",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin for OpenCode Go only: attaches a stable per-conversation x-opencode-session header (fixes 400 MissingSessionID). 仅面向 OpenCode Go：自动附加稳定的每会话请求头。",
  "license": "MIT",
  "homepage": "https://github.com/Aymadoka/madoka-dsh-plugins/tree/main/madoka-dsh-opencode-go-session#readme",
  "bugs": {
    "url": "https://github.com/Aymadoka/madoka-dsh-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aymadoka/madoka-dsh-plugins.git",
    "directory": "madoka-dsh-opencode-go-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "tsc -p tsconfig.tests.json && node .test-out/tests/header.test.js",
    "check": "npm run build && npm run typecheck && npm run test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "opencode-go",
    "x-opencode-session",
    "missing-session-id",
    "session-affinity",
    "prompt-cache"
  ]
}
